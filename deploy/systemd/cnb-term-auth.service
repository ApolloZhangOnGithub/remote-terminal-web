# cnb-term-auth.service — rtw 后端 (HTTP :8092)
[Unit]
Description=cnb terminal auth-check & rtw backend
After=network.target mysql.service nginx.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/cnb-terminal
EnvironmentFile=-/etc/cnb-terminal.env
# 认证模式: 默认复用站点登录; 设 RTW_STANDALONE_AUTH=1 + RTW_SECRET 走独立 GitHub OAuth
# RTW_STANDALONE_AUTH=1
# RTW_SECRET=<openssl rand -hex 32 生成, 必须设置>
ExecStart=/usr/bin/python3 /opt/cnb-terminal/rtw_backend.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
